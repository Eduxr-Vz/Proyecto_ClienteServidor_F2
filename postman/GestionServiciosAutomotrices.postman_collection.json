{
  "info": {
    "name": "Gestión Servicios Automotrices - Fase 3",
    "description": "CRUD completo de Tickets, Clientes, Vehículos, Mecánicos y Servicios. Incluye casos exitosos y casos de error de cada endpoint. Ejecutar las carpetas en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7122",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Tickets",
      "item": [
        {
          "name": "1.1 GET todos (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            },
            "description": "Devuelve los tickets con datos de paginación (pagina, porPagina, totalRegistros, totalPaginas, datos). Respuesta esperada: 200 OK."
          }
        },
        {
          "name": "1.2 GET con filtros y paginación",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?estado=EnProceso&pagina=1&porPagina=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"],
              "query": [
                { "key": "estado", "value": "EnProceso" },
                { "key": "idMecanico", "value": "1", "disabled": true },
                { "key": "pagina", "value": "1" },
                { "key": "porPagina", "value": "5" }
              ]
            },
            "description": "Filtra por estado y/o mecánico con paginación. Estados válidos: Abierto, EnProceso, Terminado, Entregado, Cancelado. Respuesta esperada: 200 OK."
          }
        },
        {
          "name": "1.3 GET por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "1"]
            },
            "description": "Respuesta esperada: 200 OK."
          }
        },
        {
          "name": "1.4 GET id inexistente (error)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "999"]
            },
            "description": "Respuesta esperada: 404 Not Found."
          }
        },
        {
          "name": "1.5 POST crear con servicios",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idVehiculo\": 4,\n  \"descripcionProblema\": \"Ruido metálico al frenar y el volante vibra en carretera.\",\n  \"idMecanico\": 3,\n  \"idsServicios\": [3, 4]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            },
            "description": "Crea un ticket con folio consecutivo y total calculado (1800 + 600 = 2400). Respuesta esperada: 201 Created."
          }
        },
        {
          "name": "1.6 POST vehículo con ticket abierto (error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idVehiculo\": 1,\n  \"descripcionProblema\": \"Segundo ticket para un vehículo que ya tiene uno abierto.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            },
            "description": "Regla de negocio: un vehículo no puede tener dos órdenes de servicio sin cerrar. Respuesta esperada: 400 Bad Request."
          }
        },
        {
          "name": "1.7 POST falla validación (error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idVehiculo\": 2,\n  \"descripcionProblema\": \"corto\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            },
            "description": "La descripción tiene menos de 10 caracteres. Respuesta esperada: 400 Bad Request."
          }
        },
        {
          "name": "1.8 PUT actualizar servicios (recalcula total)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EnProceso\",\n  \"observaciones\": \"Se detectó también fuga de aceite; se agrega afinación.\",\n  \"idsServicios\": [3, 4, 2]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "2"]
            },
            "description": "Agrega o quita servicios del ticket y recalcula el Total. Los servicios que ya estaban conservan su precio original. Respuesta esperada: 200 OK."
          }
        },
        {
          "name": "1.9 PUT id inexistente (error)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EnProceso\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "999"]
            },
            "description": "Respuesta esperada: 404 Not Found."
          }
        },
        {
          "name": "1.10 PATCH cambiar solo el estado",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "\"Terminado\"" },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/2/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "2", "estado"]
            },
            "description": "Cambia únicamente el estado. Entregado y Cancelado son estados finales: salir de ellos devuelve 400. Respuesta esperada: 200 OK."
          }
        },
        {
          "name": "1.11 DELETE eliminar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "3"]
            },
            "description": "Elimina el ticket y sus servicios asociados (usa el id creado en 1.5). Los tickets Entregados no se pueden eliminar (400). Respuesta esperada: 204 No Content."
          }
        },
        {
          "name": "1.12 DELETE id inexistente (error)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "999"]
            },
            "description": "Respuesta esperada: 404 Not Found."
          }
        }
      ]
    },
