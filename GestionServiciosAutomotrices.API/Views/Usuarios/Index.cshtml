@model IEnumerable<GestionServiciosAutomotrices.API.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
    var miId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios del sistema</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nueva cuenta</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th>Nombre completo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Último acceso</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var esMiCuenta = miId == u.IdUsuario.ToString();
                    <tr class="@(u.Activo ? "" : "opacity-50")">
                        <td>
                            <span class="fw-semibold">@u.NombreUsuario</span>
                            @if (esMiCuenta)
                            {
                                <span class="badge bg-info text-dark ms-1">tú</span>
                            }
                        </td>
                        <td>@u.NombreCompleto</td>
                        <td><partial name="_RolBadge" model="u.Rol" /></td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="badge bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td class="text-muted small">
                            @(u.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca")
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.IdUsuario" class="btn btn-sm btn-outline-secondary">Editar</a>
                            @if (!esMiCuenta)
                            {
                                <a asp-action="Delete" asp-route-id="@u.IdUsuario" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="alert alert-light border mt-3 small">
    <strong>Roles:</strong>
    <span class="badge bg-dark">Administrador</span> acceso total, incluida esta pantalla ·
    <span class="badge bg-primary">Recepcionista</span> da de alta y edita, pero no elimina ·
    <span class="badge bg-secondary">Mecanico</span> consulta y actualiza el avance de los tickets.
</div>
