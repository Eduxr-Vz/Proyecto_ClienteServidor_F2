<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestión de Servicios Automotrices</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Tickets" asp-action="Index">🔧 Taller — Gestión de Servicios</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Tickets" asp-action="Index">
                    Tickets
                    <span id="contador-pendientes"
                          class="badge text-bg-warning @(ViewBag.TicketsPendientes > 0 ? "" : "d-none")"
                          title="Tickets sin entregar">@ViewBag.TicketsPendientes</span>
                </a>
                <a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a>
                <a class="nav-link" asp-controller="Vehiculos" asp-action="Index">Vehículos</a>
                <a class="nav-link" asp-controller="Mecanicos" asp-action="Index">Mecánicos</a>
                <a class="nav-link" asp-controller="Servicios" asp-action="Index">Servicios</a>
                @if (User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador))
                {
                    <a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                }
                <a class="nav-link" href="/swagger" target="_blank">API (Swagger)</a>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span id="estado-conexion" class="badge text-bg-secondary" title="Conectando...">Conectando</span>

                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name)
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="dropdown-header">
                            @User.Identity?.Name
                            <span class="badge bg-secondary ms-1">
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                            </span>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Cuenta" asp-action="Logout" method="post" class="px-3 py-1">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">Cerrar sesión</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Aquí se apilan los avisos que llegan por SignalR -->
    <div id="contenedor-notificaciones" class="toast-container position-fixed top-0 end-0 p-3"
         style="z-index: 1090; margin-top: 4.5rem;"></div>

    <main class="container pb-5">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted small pb-3">
        Proyecto Cliente Servidor — API REST + MVC en un solo proyecto
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    @if (TempData["Mensaje"] != null)
    {
        @* Aviso de la propia acción del usuario: como al guardar se redirige a
           otra página, la notificación de SignalR no alcanza a verse en esta
           ventana, así que se muestra aquí al cargar. *@
        <script>
            Avisos.mostrar({
                tipo: "propio",
                titulo: "Listo",
                mensaje: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Mensaje"]?.ToString()))
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
