@model IEnumerable<GestionServiciosAutomotrices.API.Models.Mecanico>
@{
    ViewData["Title"] = "Mecánicos";
    var soloActivos = (bool)ViewBag.SoloActivos;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Mecánicos</h1>
    @if ((User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador) || User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Recepcionista)))
    {
        <a asp-action="Create" class="btn btn-primary">+ Nuevo mecánico</a>
    }
</div>

<div class="btn-group mb-3">
    <a asp-action="Index" asp-route-soloActivos="false"
       class="btn btn-sm @(soloActivos ? "btn-outline-secondary" : "btn-secondary")">Todos</a>
    <a asp-action="Index" asp-route-soloActivos="true"
       class="btn btn-sm @(soloActivos ? "btn-secondary" : "btn-outline-secondary")">Solo activos</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Especialidad</th>
                    <th>Teléfono</th>
                    <th class="text-center">Tickets</th>
                    <th class="text-center">Pendientes</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay mecánicos registrados.</td></tr>
                }
                @foreach (var m in Model)
                {
                    var pendientes = m.Tickets.Count(t => t.Estado != EstadoTicket.Entregado && t.Estado != EstadoTicket.Cancelado);
                    <tr class="@(m.Activo ? "" : "opacity-50")">
                        <td>
                            <a asp-action="Details" asp-route-id="@m.IdMecanico" class="fw-semibold text-decoration-none">
                                @m.Nombre @m.Apellidos
                            </a>
                        </td>
                        <td>@(m.Especialidad ?? "General")</td>
                        <td>@(m.Telefono ?? "—")</td>
                        <td class="text-center"><span class="badge bg-secondary">@m.Tickets.Count</span></td>
                        <td class="text-center">
                            @if (pendientes > 0)
                            {
                                <span class="badge bg-warning text-dark">@pendientes</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (m.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            @if ((User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador) || User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Recepcionista)))
                            {
                                <a asp-action="Edit" asp-route-id="@m.IdMecanico" class="btn btn-sm btn-outline-secondary">Editar</a>
                            }
                            @if (User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador))
                            {
                                <a asp-action="Delete" asp-route-id="@m.IdMecanico" class="btn btn-sm btn-outline-danger">Baja</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
