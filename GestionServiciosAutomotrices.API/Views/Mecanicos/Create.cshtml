@model GestionServiciosAutomotrices.API.DTOs.MecanicoGuardarDto
@{
    ViewData["Title"] = "Nuevo mecánico";
}

<h1 class="h3 mb-3">Registrar mecánico</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <partial name="_Formulario" model="Model" />
                    <button type="submit" class="btn btn-primary">Guardar mecánico</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScripts" />
}
