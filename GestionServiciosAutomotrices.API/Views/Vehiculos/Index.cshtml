@model IEnumerable<GestionServiciosAutomotrices.API.Models.Vehiculo>
@{
    ViewData["Title"] = "Vehículos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Vehículos</h1>
    @if ((User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador) || User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Recepcionista)))
    {
        <a asp-action="Create" class="btn btn-primary">+ Nuevo vehículo</a>
    }
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 420px;">
        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar por marca, modelo o placas" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Buscar))
        {
            <a asp-action="Index" class="btn btn-outline-dark">Limpiar</a>
        }
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Vehículo</th>
                    <th>Placas</th>
                    <th>Color</th>
                    <th>Dueño</th>
                    <th class="text-center">Tickets</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No hay vehículos que coincidan con la búsqueda.
                        </td>
                    </tr>
                }
                @foreach (var v in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@v.IdVehiculo" class="fw-semibold text-decoration-none">
                                @v.Marca @v.Modelo @v.Anio
                            </a>
                        </td>
                        <td><span class="badge bg-dark">@v.Placas</span></td>
                        <td>@(v.Color ?? "—")</td>
                        <td>
                            <a asp-controller="Clientes" asp-action="Details" asp-route-id="@v.IdCliente"
                               class="text-decoration-none">
                                @v.Cliente?.Nombre @v.Cliente?.Apellidos
                            </a>
                        </td>
                        <td class="text-center"><span class="badge bg-secondary">@v.Tickets.Count</span></td>
                        <td class="text-end">
                            @if ((User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador) || User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Recepcionista)))
                            {
                                <a asp-action="Edit" asp-route-id="@v.IdVehiculo" class="btn btn-sm btn-outline-secondary">Editar</a>
                            }
                            @if (User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador))
                            {
                                <a asp-action="Delete" asp-route-id="@v.IdVehiculo" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
