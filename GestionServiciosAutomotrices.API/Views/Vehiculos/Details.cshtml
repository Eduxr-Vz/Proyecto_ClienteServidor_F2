@model GestionServiciosAutomotrices.API.Models.Vehiculo
@{
    ViewData["Title"] = $"{Model.Marca} {Model.Modelo}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Marca @Model.Modelo @Model.Anio <span class="badge bg-dark align-middle">@Model.Placas</span></h1>
    <div>
        @if ((User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador) || User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Recepcionista)))
        {
            <a asp-action="Edit" asp-route-id="@Model.IdVehiculo" class="btn btn-outline-secondary">Editar</a>
        }
        <a asp-action="Index" class="btn btn-outline-dark">Volver a la lista</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Datos del vehículo</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Dueño</dt>
                    <dd class="col-sm-7">
                        <a asp-controller="Clientes" asp-action="Details" asp-route-id="@Model.IdCliente"
                           class="text-decoration-none">
                            @Model.Cliente?.Nombre @Model.Cliente?.Apellidos
                        </a>
                    </dd>

                    <dt class="col-sm-5">Color</dt>
                    <dd class="col-sm-7">@(Model.Color ?? "—")</dd>

                    <dt class="col-sm-5">Número de serie</dt>
                    <dd class="col-sm-7"><span class="font-monospace small">@(Model.NumeroSerie ?? "—")</span></dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Historial de tickets</span>
                @if ((User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador) || User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Recepcionista)))
                {
                    <a asp-controller="Tickets" asp-action="Create" class="btn btn-sm btn-outline-primary">+ Nuevo ticket</a>
                }
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <tbody>
                        @if (!Model.Tickets.Any())
                        {
                            <tr><td class="text-muted text-center py-3">Este vehículo no tiene tickets registrados.</td></tr>
                        }
                        @foreach (var t in Model.Tickets.OrderByDescending(t => t.FechaCreacion))
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@t.IdTicket"
                                       class="text-decoration-none fw-semibold">@t.Folio</a>
                                </td>
                                <td><partial name="_EstadoBadge" model="t.Estado" /></td>
                                <td class="text-muted small">@t.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@t.Total.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
