@model GestionServiciosAutomotrices.API.DTOs.VehiculoGuardarDto

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="mb-3">
    <label asp-for="IdCliente" class="form-label"></label>
    <select asp-for="IdCliente" asp-items="ViewBag.Clientes" class="form-select">
        <option value="">-- Selecciona el dueño --</option>
    </select>
    <span asp-validation-for="IdCliente" class="text-danger small"></span>
</div>

<div class="row">
    <div class="col-md-5 mb-3">
        <label asp-for="Marca" class="form-label"></label>
        <input asp-for="Marca" class="form-control" placeholder="Nissan" />
        <span asp-validation-for="Marca" class="text-danger small"></span>
    </div>
    <div class="col-md-5 mb-3">
        <label asp-for="Modelo" class="form-label"></label>
        <input asp-for="Modelo" class="form-control" placeholder="Versa" />
        <span asp-validation-for="Modelo" class="text-danger small"></span>
    </div>
    <div class="col-md-2 mb-3">
        <label asp-for="Anio" class="form-label"></label>
        <input asp-for="Anio" class="form-control" />
        <span asp-validation-for="Anio" class="text-danger small"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Placas" class="form-label"></label>
        <input asp-for="Placas" class="form-control text-uppercase" placeholder="ABC-123-A" />
        <span asp-validation-for="Placas" class="text-danger small"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" class="form-control" placeholder="Rojo" />
        <span asp-validation-for="Color" class="text-danger small"></span>
    </div>
    <div class="col-md-5 mb-3">
        <label asp-for="NumeroSerie" class="form-label"></label>
        <input asp-for="NumeroSerie" class="form-control text-uppercase" placeholder="Opcional — 17 caracteres" />
        <span asp-validation-for="NumeroSerie" class="text-danger small"></span>
    </div>
</div>
