@model GestionServiciosAutomotrices.API.DTOs.ClienteGuardarDto

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Juan" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Apellidos" class="form-label"></label>
        <input asp-for="Apellidos" class="form-control" placeholder="Pérez García" />
        <span asp-validation-for="Apellidos" class="text-danger small"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" class="form-control" placeholder="6621234567" />
        <span asp-validation-for="Telefono" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" placeholder="cliente@example.com" />
        <span asp-validation-for="Correo" class="text-danger small"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Direccion" class="form-label"></label>
    <textarea asp-for="Direccion" class="form-control" rows="2" placeholder="Calle, número, colonia"></textarea>
    <span asp-validation-for="Direccion" class="text-danger small"></span>
</div>
