@model IEnumerable<GestionServiciosAutomotrices.API.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Clientes</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo cliente</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 420px;">
        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar por nombre, apellidos o teléfono" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Buscar))
        {
            <a asp-action="Index" class="btn btn-outline-dark">Limpiar</a>
        }
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th class="text-center">Vehículos</th>
                    <th>Registro</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No hay clientes que coincidan con la búsqueda.
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.IdCliente" class="fw-semibold text-decoration-none">
                                @c.Nombre @c.Apellidos
                            </a>
                        </td>
                        <td>@(c.Telefono ?? "—")</td>
                        <td>@(c.Correo ?? "—")</td>
                        <td class="text-center"><span class="badge bg-secondary">@c.Vehiculos.Count</span></td>
                        <td>@c.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@c.IdCliente" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@c.IdCliente" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
