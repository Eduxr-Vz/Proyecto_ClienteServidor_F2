@model GestionServiciosAutomotrices.API.DTOs.ServicioGuardarDto

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" placeholder="Cambio de aceite" />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="2"
              placeholder="Qué incluye el servicio (opcional)"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger small"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <span asp-validation-for="Precio" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="TiempoEstimadoMin" class="form-label"></label>
        <div class="input-group">
            <input asp-for="TiempoEstimadoMin" class="form-control" type="number" min="1" />
            <span class="input-group-text">minutos</span>
        </div>
        <span asp-validation-for="TiempoEstimadoMin" class="text-danger small"></span>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label"></label>
</div>
