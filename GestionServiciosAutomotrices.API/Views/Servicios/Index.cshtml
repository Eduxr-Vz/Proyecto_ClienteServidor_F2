@model IEnumerable<GestionServiciosAutomotrices.API.Models.Servicio>
@{
    ViewData["Title"] = "Servicios";
    var soloActivos = (bool)ViewBag.SoloActivos;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Catálogo de servicios</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo servicio</a>
</div>

<div class="btn-group mb-3">
    <a asp-action="Index" asp-route-soloActivos="false"
       class="btn btn-sm @(soloActivos ? "btn-outline-secondary" : "btn-secondary")">Todos</a>
    <a asp-action="Index" asp-route-soloActivos="true"
       class="btn btn-sm @(soloActivos ? "btn-secondary" : "btn-outline-secondary")">Solo activos</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Servicio</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Tiempo</th>
                    <th class="text-center">Aplicado</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay servicios en el catálogo.</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr class="@(s.Activo ? "" : "opacity-50")">
                        <td>
                            <a asp-action="Details" asp-route-id="@s.IdServicio" class="fw-semibold text-decoration-none">
                                @s.Nombre
                            </a>
                            @if (!string.IsNullOrWhiteSpace(s.Descripcion))
                            {
                                <div class="text-muted small">@s.Descripcion</div>
                            }
                        </td>
                        <td class="text-end fw-semibold">@s.Precio.ToString("C")</td>
                        <td class="text-center text-muted">
                            @(s.TiempoEstimadoMin.HasValue ? $"{s.TiempoEstimadoMin} min" : "—")
                        </td>
                        <td class="text-center"><span class="badge bg-secondary">@s.TicketServicios.Count</span></td>
                        <td>
                            @if (s.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@s.IdServicio" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@s.IdServicio" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
