@model GestionServiciosAutomotrices.API.Models.Servicio
@{
    ViewData["Title"] = Model.Nombre;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">
        @Model.Nombre
        @if (Model.Activo)
        {
            <span class="badge bg-success align-middle">Activo</span>
        }
        else
        {
            <span class="badge bg-secondary align-middle">Inactivo</span>
        }
    </h1>
    <div>
        @if ((User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Administrador) || User.IsInRole(GestionServiciosAutomotrices.API.Models.RolUsuario.Recepcionista)))
        {
            <a asp-action="Edit" asp-route-id="@Model.IdServicio" class="btn btn-outline-secondary">Editar</a>
        }
        <a asp-action="Index" class="btn btn-outline-dark">Volver al catálogo</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Datos del servicio</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Precio actual</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.Precio.ToString("C")</dd>

                    <dt class="col-sm-5">Tiempo estimado</dt>
                    <dd class="col-sm-7">@(Model.TiempoEstimadoMin.HasValue ? $"{Model.TiempoEstimadoMin} minutos" : "—")</dd>

                    <dt class="col-sm-5">Descripción</dt>
                    <dd class="col-sm-7">@(Model.Descripcion ?? "—")</dd>

                    <dt class="col-sm-5">Veces aplicado</dt>
                    <dd class="col-sm-7">@Model.TicketServicios.Count</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Tickets donde se aplicó</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket</th>
                            <th class="text-end">Precio cobrado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TicketServicios.Any())
                        {
                            <tr><td colspan="2" class="text-muted text-center py-3">Este servicio aún no se aplica en ningún ticket.</td></tr>
                        }
                        @foreach (var ts in Model.TicketServicios)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ts.IdTicket"
                                       class="text-decoration-none fw-semibold">@ts.Ticket?.Folio</a>
                                </td>
                                <td class="text-end">
                                    @ts.PrecioAplicado.ToString("C")
                                    @if (ts.PrecioAplicado != Model.Precio)
                                    {
                                        <span class="badge bg-light text-dark ms-1">precio anterior</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
