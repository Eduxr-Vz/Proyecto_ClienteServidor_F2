@model GestionServiciosAutomotrices.API.DTOs.ServicioGuardarDto
@{
    ViewData["Title"] = "Editar servicio";
}

<h1 class="h3 mb-3">Editar servicio</h1>

<div class="alert alert-info">
    Cambiar el precio aquí <strong>no modifica los tickets ya creados</strong>: cada ticket guarda el precio
    que tenía el servicio cuando se aplicó.
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@ViewBag.IdServicio" method="post">
                    <partial name="_Formulario" model="Model" />
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Details" asp-route-id="@ViewBag.IdServicio" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScripts" />
}
