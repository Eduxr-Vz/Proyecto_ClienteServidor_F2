@model IEnumerable<GestionServiciosAutomotrices.API.Models.Ticket>
@{
    ViewData["Title"] = "Tickets";
    var estado = (EstadoTicket?)ViewBag.Estado;
    var idMecanico = (int?)ViewBag.IdMecanico;
    var pagina = (int)ViewBag.Pagina;
    var totalPaginas = (int)ViewBag.TotalPaginas;
    var totalRegistros = (int)ViewBag.TotalRegistros;
    var hayFiltros = estado.HasValue || idMecanico.HasValue;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tickets del taller</h1>
    <div>
        <a asp-action="PdfListado" asp-route-estado="@estado" asp-route-idMecanico="@idMecanico"
           class="btn btn-outline-danger">Exportar a PDF</a>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo ticket</a>
    </div>
</div>

<form asp-action="Index" method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label mb-1 small">Estado</label>
            <select name="estado" class="form-select form-select-sm"
                    asp-items="Html.GetEnumSelectList<EstadoTicket>()">
                <option value="">Todos los estados</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label mb-1 small">Mecánico</label>
            <select name="idMecanico" class="form-select form-select-sm" asp-items="ViewBag.Mecanicos">
                <option value="">Todos los mecánicos</option>
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-sm btn-secondary">Filtrar</button>
            @if (hayFiltros)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar filtros</a>
            }
        </div>
    </div>
</form>

<p class="text-muted small">
    @totalRegistros ticket(s) encontrado(s)@(totalPaginas > 1 ? $" — página {pagina} de {totalPaginas}" : "")
</p>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Folio</th>
                    <th>Vehículo</th>
                    <th>Cliente</th>
                    <th>Mecánico</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th>Creado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            @(hayFiltros
                                ? "Ningún ticket coincide con los filtros seleccionados."
                                : "No hay tickets registrados. Crea el primero con el botón \"Nuevo ticket\".")
                        </td>
                    </tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@t.IdTicket" class="fw-semibold text-decoration-none">@t.Folio</a></td>
                        <td>@t.Vehiculo?.Marca @t.Vehiculo?.Modelo <span class="text-muted small">@t.Vehiculo?.Placas</span></td>
                        <td>@t.Vehiculo?.Cliente?.Nombre @t.Vehiculo?.Cliente?.Apellidos</td>
                        <td>
                            @if (t.Mecanico != null)
                            {
                                @($"{t.Mecanico.Nombre} {t.Mecanico.Apellidos}")
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Sin asignar</span>
                            }
                        </td>
                        <td><partial name="_EstadoBadge" model="t.Estado" /></td>
                        <td class="text-end">@t.Total.ToString("C")</td>
                        <td>@t.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Pdf" asp-route-id="@t.IdTicket" class="btn btn-sm btn-outline-dark"
                               title="Descargar la orden de servicio en PDF">PDF</a>
                            <a asp-action="Edit" asp-route-id="@t.IdTicket" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@t.IdTicket" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPaginas > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            <li class="page-item @(pagina <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-estado="@estado"
                   asp-route-idMecanico="@idMecanico" asp-route-pagina="@(pagina - 1)">Anterior</a>
            </li>
            @for (var p = 1; p <= totalPaginas; p++)
            {
                <li class="page-item @(p == pagina ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-estado="@estado"
                       asp-route-idMecanico="@idMecanico" asp-route-pagina="@p">@p</a>
                </li>
            }
            <li class="page-item @(pagina >= totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-estado="@estado"
                   asp-route-idMecanico="@idMecanico" asp-route-pagina="@(pagina + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
